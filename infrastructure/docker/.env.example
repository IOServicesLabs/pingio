# Database
POSTGRES_USER=pingio
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=pingio

# Redis (set explicitly when not using docker-compose)
# REDIS_URL=redis://redis:6379

# JWT Secret (only used in self-hosted / local auth mode)
# Generate a strong secret with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Public domains (used by Caddy reverse proxy)
AUTH_DOMAIN=auth.pingio.io
RELAY_DOMAIN=relay.pingio.io

# Auth service
AUTH_ISSUER=https://auth.pingio.io
AUTH_AUDIENCE=pingio-relay
RELAY_ID=
RELAY_URL=wss://relay.pingio.io/ws

# Security Settings
# Enable device verification for new devices (recommended for production)
DEVICE_VERIFICATION_REQUIRED=true

# Maximum devices per user (default: 5)
MAX_DEVICES_PER_USER=5

# Access token expiry in minutes (default: 60)
TOKEN_EXPIRY_MINUTES=60

# Server-wide message retention in minutes; 0 = keep forever (default: 0).
# Channels can override via POST /api/channels/:id/retention.
MESSAGE_RETENTION_MINUTES=0

# Refresh token expiry in days (default: 30)
REFRESH_TOKEN_EXPIRY_DAYS=30

# CORS (set to comma-separated origins or 'false' for no CORS in production)
CORS_ORIGIN=false

# Trust proxy headers when behind Caddy/nginx
TRUST_PROXY=true

# Build-group artifact storage (MCP server side)
# LOCAL_ARTIFACT_DIR=/app/artifacts
# MAX_ARTIFACT_MESSAGE_SIZE=1048576

# Artifact cleanup: remove artifact directories older than N hours (default: 24)
# ARTIFACT_CLEANUP_INTERVAL_HOURS=1
# ARTIFACT_MAX_AGE_HOURS=24

# Enterprise SSO (auth server only) — JSON array of upstream OIDC providers.
# Each provider makes Pingio a confidential OIDC client of a corporate IdP
# (Okta, Entra ID, Google Workspace, Keycloak, ...). Register this redirect URI
# at the IdP per provider:  https://<AUTH_DOMAIN>/oauth/sso/<slug>/callback
#
# Fields: slug (a-z0-9-, unique), name, issuerUrl (no trailing slash),
#         clientId, clientSecret, allowedDomains (optional email-domain allowlist)
#
# SSO_PROVIDERS=[{"slug":"acme","name":"Acme Corp SSO","issuerUrl":"https://login.microsoftonline.com/<tenant-id>/v2.0","clientId":"<app-client-id>","clientSecret":"<app-client-secret>","allowedDomains":["acme.com"]}]
