# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy all workspace manifests + lockfile for reproducible installs
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/mcp-server/package.json packages/mcp-server/
COPY packages/relay-server/package.json packages/relay-server/
COPY packages/auth-server/package.json packages/auth-server/

# Install dependencies (dev included — tsc is needed to build)
RUN npm ci --workspace=@pingio/shared --workspace=@pingio/relay-server --include-workspace-root=false

# Copy source files
COPY packages/shared packages/shared
COPY packages/relay-server packages/relay-server

# Build packages
RUN npm run build --workspace=@pingio/shared \
 && npm run build --workspace=@pingio/relay-server

# Production stage
FROM node:20-alpine AS production

# Init system: forward SIGTERM/SIGINT to node for graceful shutdown
RUN apk add --no-cache dumb-init

WORKDIR /app

# Copy manifests + lockfile and install production deps only
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/mcp-server/package.json packages/mcp-server/
COPY packages/relay-server/package.json packages/relay-server/
COPY packages/auth-server/package.json packages/auth-server/
RUN npm ci --omit=dev --workspace=@pingio/shared --workspace=@pingio/relay-server --include-workspace-root=false \
 && npm cache clean --force

# Copy built files
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/relay-server/dist ./packages/relay-server/dist

# Set environment
ENV NODE_ENV=production
ENV PORT=3000

LABEL org.opencontainers.image.source="https://github.com/IOServicesLabs/pingio" \
      org.opencontainers.image.title="pingio-relay" \
      org.opencontainers.image.description="Pingio relay server — REST + WebSocket messaging relay"

# Run as the unprivileged node user
USER node

EXPOSE 3000

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "packages/relay-server/dist/index.js"]
