{
  "name": "pingio-mcp-server",
  "version": "0.1.3",
  "description": "Pingio — secure messaging MCP server for agents and terminals (connects to any Pingio relay)",
  "license": "MIT",
  "homepage": "https://github.com/IOServicesLabs/pingio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IOServicesLabs/pingio.git",
    "directory": "packages/mcp-server"
  },
  "bugs": "https://github.com/IOServicesLabs/pingio/issues",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "main": "dist/server.js",
  "bin": {
    "pingio": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/server.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/server.js",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "ws": "^8.16.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^1.6.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.1"
  }
}
