{
  "name": "@pingio/mcp-server",
  "version": "0.1.0",
  "description": "Pingio MCP server — secure terminal messaging and agent collaboration",
  "main": "dist/server.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pingio": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pingio/shared": "*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.0",
    "bonjour-service": "^1.2.0",
    "dotenv": "^16.4.0",
    "jsonwebtoken": "^9.0.0",
    "node-datachannel": "^0.10.0",
    "uuid": "^9.0.0",
    "ws": "^8.16.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^1.6.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.1"
  }
}
