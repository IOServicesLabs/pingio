  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "relay-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
